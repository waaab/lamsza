{
	"name": "lamsza",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run preflight && vite build",
		"build:no-preflight": "vite build",
		"preflight": "node scripts/preflight-api.js",
		"build:extension": "npm run build && node scripts/extract-inline-scripts.js && rm -rf extension && cp -r dist extension && cp manifest.json extension/ && cp static/icon.png extension/",
		"preview": "vite preview",
		"test": "node --test \"tests/*.test.js\"",
		"test:go": "scripts/test-go.sh",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.51.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"marked": "^17.0.4"
	}
}
